@using SIGA.Application.Dtos.Identity.Account
@model RegisterDto

@{
    ViewData["Title"] = "Registro de Usuario";
}

<!-- Fondo institucional -->
<style>
    html, body {
        height: 100%;
        margin: 0;
        overflow-x: hidden;
        background: linear-gradient(135deg, #002147, #003366);
        color: #f5f7fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
</style>

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4" style="background-color: #f9f9f9; color: #2e3a4e;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <img src="~/images/logo_siga.png" alt="SIGA" width="80" class="mb-3" />
                        <h3 class="fw-bold">Registro de Usuario</h3>
                        <p class="text-secondary">Crea una cuenta para acceder al sistema académico</p>
                    </div>

                    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                    <form asp-action="Register" asp-controller="Users" method="post" enctype="multipart/form-data">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-semibold">Nombre</label>
                                <input asp-for="FirstName" class="form-control bg-light border-0 border-bottom border-primary p-3" placeholder="Ingrese su nombre" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-semibold">Apellido</label>
                                <input asp-for="LastName" class="form-control bg-light border-0 border-bottom border-primary p-3" placeholder="Ingrese su apellido" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Username" class="form-label fw-semibold">Nombre de usuario</label>
                                <input asp-for="Username" class="form-control bg-light border-0 border-bottom border-primary p-3" placeholder="Usuario123" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Gender" class="form-label fw-semibold">Sexo</label>
                                <select asp-for="Gender" class="form-select bg-light border-0 border-bottom border-primary p-3">
                                    <option value="">Seleccione...</option>
                                    <option value="M">Masculino</option>
                                    <option value="F">Femenino</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Correo electrónico</label>
                            <input asp-for="Email" type="email" class="form-control bg-light border-0 border-bottom border-primary p-3" placeholder="ejemplo@instituto.edu" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold">Teléfono</label>
                            <input asp-for="Phone" class="form-control bg-light border-0 border-bottom border-primary p-3" placeholder="809-000-0000" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="State" class="form-label fw-semibold">Estado</label>
                            <select asp-for="State" class="form-select bg-light border-0 border-bottom border-primary p-3">
                                <option value="">Seleccione...</option>
                                <option value="Activo">Activo</option>
                                <option value="Inactivo">Inactivo</option>
                            </select>
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                                <input asp-for="Password" type="password" class="form-control bg-light border-0 border-bottom border-primary p-3" placeholder="********" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmar contraseña</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-0 border-bottom border-primary p-3" placeholder="********" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Role" class="form-label fw-semibold">Rol</label>
                            <select asp-for="Role" class="form-select bg-light border-0 border-bottom border-primary p-3">
                                <option value="">Seleccione...</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Estudiante">Estudiante</option>
                                <option value="Profesor">Profesor</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="File" class="form-label fw-semibold">Foto de perfil</label>
                            <input asp-for="File" type="file" class="form-control bg-light border-0 border-bottom border-primary p-3" accept="image/*" />
                            <span asp-validation-for="File" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg py-3 fw-semibold rounded-pill">
                                Registrarse
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <a asp-controller="Cuenta" asp-action="Login" class="text-primary text-decoration-none d-block">
                                ¿Ya tienes una cuenta? Inicia sesión
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4 text-center">
                <p class="text-light">
                    Forma parte del <strong>Sistema de Gestión Académica (SIGA)</strong> y accede a todas las herramientas educativas disponibles.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Estilos adicionales -->
<style>
    .card {
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4);
        }

    .btn {
        border-radius: 50px;
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0, 123, 255, 0.4);
        }

    .form-control:focus, .form-select:focus {
        border-color: #0056b3;
        box-shadow: 0 0 0 0.2rem rgba(0, 86, 179, 0.25);
    }

    .text-danger.small {
        font-size: 0.85rem;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
