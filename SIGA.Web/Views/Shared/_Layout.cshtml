@using SIGA.Web.Middlewares;
@using SIGA.Application.Dtos;
@using SIGA.Application.Response;
@using SIGA.Application.Helpers;
@inject IHttpContextAccessor httpContext

@{
    var usuarios = httpContext.HttpContext.Session.Get<AuthenticationResponse>("usuario");
    var isAdmin = usuarios != null ? usuarios.Roles.Any(r => r == "Administrador") : false;
    var isStudent = usuarios != null ? usuarios.Roles.Any(r => r == "Estudiante") : false;
    var isTeacher = usuarios != null ? usuarios.Roles.Any(r => r == "Profesor") : false;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGA</title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f7fa;
            margin: 0;
            overflow-x: hidden;
        }

        /* ===== LAYOUT PRINCIPAL ===== */
        .main-layout {
            display: flex;
            min-height: 100vh;
            flex-direction: row;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: linear-gradient(180deg, #001f3f, #003366);
            color: white;
            display: flex;
            flex-direction: column;
            padding: 1rem;
            z-index: 1000;
            transition: transform 0.3s ease;
        }

        .sidebar-header {
            text-align: center;
            margin-bottom: 1.5rem;
        }

            .sidebar-header img {
                width: 80px;
                margin-bottom: 10px;
            }

            .sidebar-header h4 {
                font-weight: bold;
                color: #ffffff;
            }

        .nav-link {
            color: #f0f0f0;
            padding: 10px 15px;
            border-radius: 8px;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

            .nav-link:hover {
                background-color: rgba(255, 255, 255, 0.15);
                transform: translateX(4px);
            }

            .nav-link i {
                margin-right: 8px;
            }

        /* ===== CONTENIDO ===== */
        .content {
            margin-left: 250px;
            flex-grow: 1;
            padding: 2rem;
            background-color: #f5f7fa;
            transition: margin-left 0.3s ease;
        }

        /* ===== BOTÓN CERRAR SESIÓN ===== */
        .btn-logout {
            margin-top: auto;
            background: linear-gradient(45deg, #dc3545, #b52a37);
            border: none;
            border-radius: 30px;
            padding: 10px;
            text-align: center;
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: background 0.3s ease;
        }

            .btn-logout:hover {
                background: linear-gradient(45deg, #b52a37, #dc3545);
                text-decoration: none;
            }

        /* ===== FOOTER ===== */
        footer {
            background-color: #002147;
            color: #ccc;
            text-align: center;
            padding: 10px;
            margin-top: auto;
        }

        /* ===== RESPONSIVE ===== */
        /*media (max-width: 992px) {
            .sidebar

        {
            transform: translateX(-100%);
            position: fixed;
        }

        .sidebar.show {
            transform: translateX(0);
        }

        .content {
            margin-left: 0;
        }

        .toggle-btn {
            position: fixed;
            top: 10px;
            left: 10px;
            z-index: 1050;
            background: #003366;
            border: none;
            color: white;
            border-radius: 8px;
            padding: 8px 12px;
        }

        }*/
    </style>
</head>

<body>
    <div class="main-layout">

        <!-- Botón para mostrar sidebar en móvil -->
        <button class="toggle-btn d-lg-none" id="toggleSidebar">
            <i class="bi bi-list"></i>
        </button>

        <!-- Sidebar -->
        <nav class="sidebar" id="sidebarMenu">
            <div class="sidebar-header">
                <img src="~/images/logo_siga.png" alt="SIGA Logo" />
                <h4>SIGA</h4>
                <p class="small text-light">Gestión Académica</p>
            </div>

            <ul class="nav flex-column mb-auto">
                @if (usuarios != null)
                {
                    if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Register">
                                <i class="bi bi-person-plus"></i> Registrar Usuario
                            </a>
                        </li>
                    }

                    if (isTeacher)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Courses" asp-action="Index">
                                <i class="bi bi-journal-text"></i> Mis Cursos
                            </a>
                        </li>
                    }

                    if (isStudent)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Enrollments" asp-action="Index">
                                <i class="bi bi-mortarboard"></i> Mis Inscripciones
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Perfil" asp-action="GoToProfile">
                            <i class="bi bi-person-circle"></i> @usuarios.UserName
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#configCollapse">
                            <i class="bi bi-gear"></i> Configuración
                        </a>
                        <div class="collapse" id="configCollapse">
                            <ul class="nav flex-column ps-3">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Perfil" asp-action="EditProfile">Editar Perfil</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Users" asp-action="ForgotPassword">Cambiar Contraseña</a>
                                </li>
                            </ul>
                        </div>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Users" asp-action="Home">
                            <i class="bi bi-house"></i> Inicio
                        </a>
                    </li>
                }
            </ul>

            @if (usuarios != null)
            {
                <a class="btn-logout mt-3" asp-controller="Users" asp-action="LogOut">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
            }
        </nav>

        <!-- Contenido principal -->
        <div class="content">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
            <footer>
                &copy; 2025 - SIGA.Web | Sistema de Gestión Académica
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById('sidebarMenu');
        const toggleBtn = document.getElementById('toggleSidebar');
        toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('show');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
